<label id="user-info-overlay" for="user-info" onclick="closeUserDetails();"></label>
<div id="user-info">
    <div class="user-info-sub">
        <img src="#{user.picture}" style="height:100px; width:100px; border-radius:50%">
        <p>#{user.nickname}</p>
        <p>#{user.email}</p>
        <p>#{user.sub}</p>
    </div>
</div>