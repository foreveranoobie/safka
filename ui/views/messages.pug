<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Safka Messages</title>
    <link rel="stylesheet" href="/style.css">
</head>

body
    <div class="page-body">
        <div class="menu" style="height:200px">
            <button onclick="window.location.href='/'">Topics</button>
            <button>Brokers</button>
            <button>Consumers</button>
            <button>Send message</button>
        </div>
        <div class="content-table">
            <div id="t-head">
                <div class="row">
                    <h3>Timestamp</h3>
                    <h3>Key</h3>
                    <h3>Body</h3>
                </div>
            </div>
            <div id="t-body">
                if messages && messages.length > 0
                    each message in messages
                        .row
                            p=`${message.timestamp}`
                            p=`${message.key}`
                            p=`${message.content}`
                        hr
                else
                    .message-item No messages found.
            </div>
        </div>
    </div>
    <label id="overlay" for="msg-details" onclick="closeMsgDetails();"></label>
    <div id="msg-details">
        <label for="timestamp-area">Timestamp</label>
        <div id="timestamp-area">
            <p></p>
        </div>
        <label for="key-area">Message key</label>
        <div id="key-area">
            <p></p>
        </div>
        <label for="message-area">Message</label>
        <div id="message-area">
            <p></p>
        </div>
    </div>
    <footer>
        <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#FFFFFF">
            <path d="M240-240v-480h60v480h-60Zm447-3L453-477l234-234 43 43-191 191 191 191-43 43Z" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#FFFFFF">
            <path d="M561-240 320-481l241-241 43 43-198 198 198 198-43 43Z" />
        </svg>
        <p>1</p>
        <p>2</p>
        <p class="active-page-num">3</p>
        <p>4</p>
        <p>5</p>
        <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#FFFFFF">
            <path d="M530-481 332-679l43-43 241 241-241 241-43-43 198-198Z" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#FFFFFF">
            <path d="m272-245-43-43 192-192-192-192 43-43 235 235-235 235Zm388 5v-480h60v480h-60Z" />
        </svg>
    </footer>
    script.
        const messageItems = document.querySelectorAll('.row');
        const popup = document.getElementById('messagePopup');
        const popupContent = document.getElementById('popupContent');
        const popupClose = document.querySelector('.popup-close');
        const overlay = document.getElementById('popupOverlay');

        messageItems.forEach(preview => {
            preview.addEventListener('click', () => {
                document.getElementById('overlay').style.display = 'block'
                document.getElementById('msg-details').style.display = 'flex'

                document.querySelector('#msg-details').querySelector("#timestamp-area").textContent = preview.children[0].textContent;
                document.querySelector('#msg-details').querySelector("#key-area").textContent = preview.children[1].textContent;
                document.querySelector('#msg-details').querySelector("#message-area").textContent = preview.children[2].textContent;

                popupContent.textContent = fullContent;
                popup.style.display = 'block';
                overlay.style.display = 'block';
            });

            // Optionally add a class to visually indicate truncation
            if (preview.scrollHeight > preview.clientHeight) {
                preview.classList.add('truncated');
            }
        });

        function closeMsgDetails() {
            document.getElementById('overlay').style.display = 'none'
            document.getElementById('msg-details').style.display = 'none'
        }

        function openMsgDetails() {
            document.getElementById('overlay').style.display = 'block'
            document.getElementById('msg-details').style.display = 'flex'
        }

</html>